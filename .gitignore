# Retired homepage drafts — kept locally as process files, not published on GitHub
index-original.html
index-full-hero.html
index-fluid-hero.html

.DS_Store

# Screenshots dropped in the repo while working — never referenced by a
# page. Both spellings, since the name follows the system language.
Captura de Pantalla *
Screenshot *

# Scratch footage, not used by any page. Deliberately not *.mp4: video the
# site actually serves should still be tracked.
/hero-lassie.mp4

# Retreat photography extracted from the old site: 524 files, ~692 MB, at the
# original resolution on purpose. Too heavy for the repo, so the masters live
# beside it in ../yaww-retreat-images/ under the same retreats/... paths, which
# is why the `file` values in retreats/*/data.json still resolve there.
retreats/**/img/
retreats/_shared/

# Local preview-server config for the Claude Code browser pane. Tooling,
# not part of the site.
.claude/

# Retreat thumbnail masters: 12 PNGs, 120 MB, dropped in by hand to be
# processed. images/retreat-cards/ holds what the site actually serves
# (312x408 and 624x816 WebP, ~1.3 MB for both sets together).
images/Retreats/

# Full-page screenshots for the cleanup pass (night 11): ~100 MB of PNGs,
# a local before/after reference, not part of the site.
docs/cleanup-baseline/
